# Copy to .env and fill in what you need. Empty values use the defaults. Real environment variables win over this file.

# Address the backend listens on (loopback only in this milestone). Default 127.0.0.1
HOST=
# Port. Default 8787
PORT=
# Exact browser origins allowed to call the API, comma separated. Default http://localhost:5173,http://127.0.0.1:5173. "none" allows no browser.
ALLOWED_ORIGINS=
# Where workforce.json is kept. Default ./data
DATA_DIR=
# Absolute folder that holds every workspace. Unset = no workspaces.
WORKSPACE_ROOT=
# Named workspaces under WORKSPACE_ROOT: id:relative/path, comma separated. Example: sandbox:projects/sandbox
WORKSPACES=
# mock (default) or claude (reports "not available" until the Claude provider exists)
RUNTIME=
# Task time limit in ms. Default 600000
TASK_TIMEOUT_MS=
# How long a cancel may take before it is forced, in ms. Default 5000
CANCEL_GRACE_MS=
# How long an approval may wait, in ms. Default 300000
APPROVAL_TIMEOUT_MS=
# Tools an agent may use, comma separated, from: Read, Glob, Grep, Write, Edit, Bash, WebFetch, WebSearch. Default Read,Glob,Grep,Write,Edit. Write, Edit, Bash, WebFetch and WebSearch always need a human approval. "none" allows no tools.
ALLOWED_TOOLS=
# Largest single agent message in bytes. Default 32768
MAX_MESSAGE_BYTES=
# Largest total output per task in bytes. Default 262144
MAX_TASK_OUTPUT_BYTES=
# Events kept for reconnects. Default 500
EVENT_BUFFER_SIZE=
# Size at which data/audit.log is rotated to audit.log.1, in bytes. Default 5242880
AUDIT_LOG_MAX_BYTES=
# Read by the server only; not used until the Claude provider exists. Never put it in frontend variables.
ANTHROPIC_API_KEY=
# Frontend only; used from Stage D. Example: http://127.0.0.1:8787
VITE_WORKFORCE_API_URL=
