# Copy to .env and fill in what you need. Empty values use the defaults. Real environment variables win over this file.

# Address the backend listens on (loopback only in this milestone). Default 127.0.0.1
HOST=
# Port. Default 8787
PORT=
# Exact browser origins allowed to call the API, comma separated. Default http://localhost:5173,http://127.0.0.1:5173. "none" allows no browser.
ALLOWED_ORIGINS=
# Where workforce.json is kept. Default ./data
DATA_DIR=
# Absolute folder that holds every workspace. Unset = no workspaces.
WORKSPACE_ROOT=
# Named workspaces under WORKSPACE_ROOT: id:relative/path, comma separated. Example: sandbox:projects/sandbox
WORKSPACES=
# mock (default) or claude (reports "not available" until the Claude provider exists)
RUNTIME=
# Task time limit in ms. Default 600000
TASK_TIMEOUT_MS=
# How long a cancel may take before it is forced, in ms. Default 5000
CANCEL_GRACE_MS=
# How long an approval may wait, in ms. Default 300000
APPROVAL_TIMEOUT_MS=
# Tools an agent may use, comma separated, from: Read, Glob, Grep, Write, Edit, Bash, WebFetch, WebSearch. Default Read,Glob,Grep,Write,Edit. Write, Edit, Bash, WebFetch and WebSearch always need a human approval. "none" allows no tools.
ALLOWED_TOOLS=
# Largest single agent message in bytes. Default 32768
MAX_MESSAGE_BYTES=
# Largest total output per task in bytes. Default 262144
MAX_TASK_OUTPUT_BYTES=
# Events kept for reconnects. Default 500
EVENT_BUFFER_SIZE=
# Size at which data/audit.log is rotated to audit.log.1, in bytes. Default 5242880
AUDIT_LOG_MAX_BYTES=
# Token every API request must send as "Authorization: Bearer <token>". At least 32 characters, no spaces. Empty = a new one is
# generated at each start and written to DATA_DIR/api-token (mode 0600). Server only: never a VITE_ variable, never in a URL.
API_TOKEN=
# Read by the server only, for RUNTIME=claude. Never put it in frontend variables.
ANTHROPIC_API_KEY=
# Model for RUNTIME=claude. Empty = the Claude Code default.
CLAUDE_MODEL=
# Most model steps one task may take (1 to 100). Default 12.
CLAUDE_MAX_TURNS=
# Most a task may spend, in US dollars (the SDK's own estimate, which can be passed by a little). Default 0.5.
CLAUDE_MAX_BUDGET_USD=
# Most tasks that may run at once on RUNTIME=claude (1 to 32). Each is a child process and a paid session. Default 2.
MAX_CONCURRENT_TASKS=
# Set to yes to let a person approve file writes for a whole task or agent (RUNTIME=claude). Default: every write is approved one at a time.
ALLOW_BROAD_WRITE_SCOPES=
# Frontend only. Empty = browser mock (default). Set to the backend origin, e.g. http://127.0.0.1:8787, to use the local backend.
VITE_WORKFORCE_API_URL=
# Public gateway (npm run start:public). Password the browser asks for; required there, at least 12 characters.
VO_PASSWORD=
# Address the gateway listens on. Default 0.0.0.0
PUBLIC_HOST=
# Port the gateway listens on. Default 3000
PUBLIC_PORT=
# Set to yes to allow RUNTIME=claude on the public address. Default: refused.
VO_ALLOW_PUBLIC_CLAUDE=
